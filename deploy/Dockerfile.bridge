FROM python:3.13-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends xvfb fonts-wqy-microhei && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY scripts ./scripts
COPY telegramRSSbot.py .
CMD ["xvfb-run", "-a", "python", "-u", "src/twitter_rss_bridge.py"]
