FROM python:3.13-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends xvfb xauth fonts-wqy-microhei libgtk-3-0 libdbus-glib-1-2 libasound2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN camoufox fetch
COPY src ./src
COPY scripts ./scripts
COPY telegramRSSbot.py .
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x900x24 >/tmp/xvfb.log 2>&1 & export DISPLAY=:99; exec python -u src/twitter_rss_bridge.py"]
